# NOTE: every pattern here is root-anchored with a leading slash on purpose.
# .vercelignore uses .gitignore matching, where an unanchored `mobile/` matches
# a directory of that name at ANY depth -- which silently excluded lib/mobile/
# and app/api/mobile/ and broke the build with "Can't resolve '@/lib/mobile/auth'".

# The React Native app ships through EAS/stores, never through Vercel. Locally
# /mobile holds ~5GB of Gradle/.cxx and iOS Pods/DerivedData output, which made
# `vercel deploy` try to upload 4.2GB. tsconfig.json already excludes it and no
# web code imports from it.
/mobile/

# Local scratch: audit screenshots and search-spike output.
/.audit/
/analysis/

# Android build outputs kept at the repo root.
/*.aab
/*.apk
