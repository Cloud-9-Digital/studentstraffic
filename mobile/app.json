{
  "expo": {
    "name": "Students Traffic",
    "slug": "students-traffic",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studentstraffic",
    "newArchEnabled": false,
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a4a3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studentstraffic.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Students Traffic needs microphone access for voice calls with student guides.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "associatedDomains": [
        "applinks:www.studentstraffic.com"
      ]
    },
    "android": {
      "package": "com.studentstraffic.app",
      "googleServicesFile": "./google-services.json",
      "enableProguardInReleaseBuilds": true,
      "adaptiveIcon": {
        "backgroundColor": "#0f3d37",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 17,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.studentstraffic.com",
              "pathPrefix": "/university/"
            },
            {
              "scheme": "https",
              "host": "www.studentstraffic.com",
              "pathPrefix": "/countries"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./notifee.plugin.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a4a3a",
          "image": "./assets/splash-logo.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad3c91c1-1c05-485b-9c90-78d71f0ebc36"
      }
    },
    "owner": "bharathv"
  }
}
